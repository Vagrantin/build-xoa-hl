[Unit]
Description=XOA First Boot - Admin credentials provisioning (phase 2)
After=network-online.target xo-server.service xoa-first-boot.service redis.service
Requires=xoa-first-boot.service redis.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/root/xoa-credentials.sh
RemainAfterExit=yes
TimeoutStartSec=6min

[Install]
WantedBy=multi-user.target
